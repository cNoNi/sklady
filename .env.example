# Hasło do panelu /admin
ADMIN_PASSWORD=zmien-mnie

# Losowy sekret do podpisywania sesji admina (min. 16 znaków), np. `openssl rand -hex 32`
SESSION_SECRET=zmien-na-losowy-ciag-znakow

# Hasło użytkownika bazy (tylko litery i cyfry). Zmiana po pierwszym uruchomieniu nie zmienia hasła w istniejącej bazie.
POSTGRES_PASSWORD=sklady

# Port, pod którym strona będzie dostępna na hoście
APP_PORT=3000

# Domyślna widoczność MMR, dopóki admin nie zmieni jej w panelu (true / false)
DEFAULT_SHOW_MMR=false

# Ustaw "true" tylko jeśli serwujesz stronę przez HTTPS (np. za reverse proxy z TLS).
# Przy "true" logowanie admina nie zadziała przez zwykłe HTTP.
COOKIE_SECURE=false
